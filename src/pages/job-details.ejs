<%- include('../partials/head.ejs', {
    title: 'Senior Product Designer — JOBLY',
    description: 'Senior Product Designer role at NoSanD NoGames.'
}) %>
<%- include('../partials/header.ejs', { variant: 'details' }) %>

<main class="job-details-page">
    <article class="job-details" itemscope itemtype="https://schema.org/JobPosting">
        <meta itemprop="datePosted" content="2026-11-01">
        <meta itemprop="validThrough" content="2026-12-20T23:59">
        <meta itemprop="employmentType" content="FULL_TIME">
        <meta itemprop="jobLocationType" content="TELECOMMUTE">

        <header class="job-details__header">
            <div class="job-details__intro">
                <div class="job-details__eyebrows">
                    <p class="job-details__company" itemprop="hiringOrganization" itemscope itemtype="https://schema.org/Organization">
                        <span itemprop="name"><%= selectedJob.company %></span>
                    </p>
                    <span class="job-details__highlight">Featured</span>
                    <span class="job-details__highlight job-details__highlight--orange">Magazine-like</span>
                </div>
                <h1 itemprop="title" data-i18n="details.title"><%= selectedJob.title %></h1>
                <ul class="job-details__tags">
                    <li>Remote</li>
                    <li>Full-time</li>
                    <li>Senior</li>
                </ul>
            </div>
            <div class="job-details__visual">
                <span class="job-details__sticker" aria-hidden="true">Find your role</span>
                <picture class="job-details__media">
                    <source type="image/webp" srcset="./assets/images/details-hero-320.webp 320w, ./assets/images/details-hero-639.webp 639w" sizes="(max-width: 767px) 100vw, 360px">
                    <img src="./assets/images/details-hero-639.jpg" srcset="./assets/images/details-hero-320.jpg 320w, ./assets/images/details-hero-639.jpg 639w" sizes="(max-width: 767px) 100vw, 360px" width="639" height="426" alt="Designer working with a color palette and interface mockups" decoding="async">
                </picture>
            </div>
        </header>

        <div class="job-details__content">
            <div class="job-details__sections">
                <section class="job-details__section" aria-labelledby="about-role-title">
                    <h2 id="about-role-title" data-i18n="details.about.title">About the role</h2>
                    <p itemprop="description" data-i18n="details.about.text">
                        You will shape calm, useful product experiences for a startup team and work closely with product and engineering from first sketch to shipped feature.
                    </p>
                </section>

                <section class="job-details__section" aria-labelledby="responsibilities-title">
                    <h2 id="responsibilities-title" data-i18n="details.responsibilities.title">What you’ll do</h2>
                    <ul>
                        <li data-i18n="details.responsibilities.one">Design end-to-end product flows.</li>
                        <li data-i18n="details.responsibilities.two">Grow a small, practical design system.</li>
                        <li data-i18n="details.responsibilities.three">Prototype and test product ideas.</li>
                        <li data-i18n="details.responsibilities.four">Partner with engineers during delivery.</li>
                    </ul>
                </section>

                <section class="job-details__section" aria-labelledby="requirements-title">
                    <h2 id="requirements-title" data-i18n="details.requirements.title">Requirements</h2>
                    <ul class="job-details__skills">
                        <li itemprop="skills">Figma</li>
                        <li itemprop="skills">UI/UX</li>
                        <li itemprop="skills">SaaS</li>
                        <li itemprop="skills">Design systems</li>
                    </ul>
                </section>
            </div>

            <aside class="job-cta" aria-labelledby="job-cta-title">
                <div class="job-cta__panel">
                    <p class="job-cta__eyebrow">Like this role?</p>
                    <h2 id="job-cta-title" data-i18n="details.cta.title">Make your move.</h2>
                    <dl>
                        <dt data-i18n="details.cta.salary">Salary</dt>
                        <dd><%= selectedJob.salaryLabel %></dd>
                        <dt data-i18n="details.cta.workMode">Work mode</dt>
                        <dd><%= selectedJob.workMode %></dd>
                        <dt data-i18n="details.cta.team">Team</dt>
                        <dd>20–50 people</dd>
                    </dl>
                    <a href="./apply.html" data-i18n="actions.applyNow">Apply now</a>
                </div>
                <section class="job-cta__reasons" aria-labelledby="reasons-title">
                    <h3 id="reasons-title" data-i18n="details.reasons.title">Why this role stands out</h3>
                    <ul>
                        <li>Remote-friendly</li>
                        <li>Small product team</li>
                        <li>Direct impact</li>
                        <li>Flexible schedule</li>
                        <li>Growth opportunities</li>
                    </ul>
                </section>
            </aside>
        </div>
        <div class="job-details__salary" itemprop="baseSalary" itemscope itemtype="https://schema.org/MonetaryAmount">
            <meta itemprop="currency" content="USD">
            <div itemprop="value" itemscope itemtype="https://schema.org/QuantitativeValue">
                <meta itemprop="minValue" content="80000">
                <meta itemprop="maxValue" content="120000">
                <meta itemprop="unitText" content="YEAR">
            </div>
        </div>
    </article>
</main>

<%- include('../partials/footer.ejs') %>
